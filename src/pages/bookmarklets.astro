---
import Base from '../layouts/Base.astro'
import { GET } from './api/bookmarklets'
import type { GetBookmarkletResponse } from './api/bookmarklets'

const { isError, bookmarklets } = (await (
  await GET()
).json()) as GetBookmarkletResponse
---

<Base
  title="ブックマークレット"
  description="kyana0817作のちょっと役立つブックマークレット"
>
  <h1>ブックマークレット</h1>
  <section>
    {isError ? (
      <p>ブックマークレットの取得に失敗しました。</p>
    ) : (
    <table>
      <thead>
        <tr>
          <th>スクリプト</th>
          <th>説明</th>
        </tr>
      </thead>
      <tbody>
      {bookmarklets.map((bookmarklet) => (
        <tr>
          <td>
            <a href={bookmarklet.source}>{bookmarklet.name}</a>
          </td>
          <td>
            <span>{bookmarklet.description.split('\n').map((text, idx) => {
              return <>{idx > 0 && <br />}{text}</>
            })}</span>
          </td>
        </tr>
      ))}
      </tbody>
    </table>
    )}
  </section>
</Base>

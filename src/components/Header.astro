---
import { SITE_TITLE } from '../consts'
import logo from '/public/logo.svg?raw'
import burger from '/public/burger-menu.svg?raw'
---

<header class="c-app__header">
	<nav class="c-app__menu">
		<h2>
			<a class="c-app__logo" href="/">
				<span class="c-app__logo__text">{SITE_TITLE}</span>
				<Fragment set:html={logo}/>
			</a>
		</h2>
		<div class="c-app__menu-links">
			<a class="c-app__menu-link" href="/blog">記事</a>
			<a class="c-app__menu-link" href="/scrap">スクラップ</a>
			<a class="c-app__menu-link" href="/bookmarklets">ブックマークレット</a>
			<a class="c-app__menu-link" href="/about">私について</a>
		</div>
		<div class="c-app__menu-list" data-open="false">
			<button class="c-app__menu-list-button" id="menu_list_button">
				<Fragment set:html={burger}/>
			</button>
			<div class="c-app__menu-list-flow">
				<a class="c-app__menu-link" href="/blog">記事</a>
				<a class="c-app__menu-link" href="/scrap">スクラップ</a>
				<a class="c-app__menu-link" href="/bookmarklets">ブックマークレット</a>
				<a class="c-app__menu-link" href="/about">私について</a>
			</div>
		</div>
	</nav>
</header>

<script>
	(() => {
		const menuListButton = document.getElementById('menu_list_button');
		if (!menuListButton) {
			console.error('DOM Element not found');
			return;
		}
		const menuList = menuListButton?.parentElement;
		if (!menuList) {
			console.error('DOM Element not found');
			return;
		}
		const ro = new ResizeObserver(() => {
			menuList.dataset.open = 'false';
		});

		const outsideClickListener = (event: MouseEvent) => {			
			if (!menuList.contains(event.target as Node)) {
				menuList.dataset.open = 'false';
				ro.disconnect();
			}
		}
		ro.observe(document.documentElement);
		
		menuListButton.addEventListener('click', () => {
			const isOpen = menuList.dataset.open === 'true' ? 'false' : 'true';
			if (isOpen === 'true') {
				document.body.addEventListener('click', outsideClickListener);
			} else {
				document.body.removeEventListener('click', outsideClickListener);
			}
			menuList.dataset.open = isOpen;
		});		
	})()
</script>

<style>
.c-app__header {
	border-bottom: 1px solid var(--border-secondary);
	padding: 0 8px;
}

.c-app__menu {
	display: flex;
	max-width: var(--main-width);
	width: 100%;
	margin: 0 auto;
	justify-content: space-between;
	align-items: center;
	
}

.c-app__menu-links {
	display: flex;
	height: 100%;
	gap: 8px;
}

.c-app__menu-list {
	display: none;
	position: relative;
}

.c-app__menu-list-button {
	width: 64px;
	height: 64px;
	padding: 12px;
}

.c-app__menu-list-flow {
	display: none;
	background-color: var(--background-secondary);
	border: 2px solid var(--border-secondary);
	position: absolute;
	top: 80%;
	right: 0;
	z-index: 1;
	flex-direction: column;
	width: 140px;
}

.c-app__menu-list[data-open="true"]> .c-app__menu-list-flow {
	display: flex;
}

@media (max-width: 768px) {
	.c-app__menu-links {
		display: none;
	}
			
	.c-app__menu-list {
		display: block;
	}

}

.c-app__menu-link {
	text-decoration: none;
	padding-left: 4px;
	font-size: 1.6rem;
	color: var(--text-primary);
	font-weight: 600;
	line-height: 2;
}

.c-app__menu-link:hover {
	text-decoration: underline;
}

.c-app__logo {
	color: var(--text-primary);
}

.c-app__logo > svg {
	user-select: none;
}

.c-app__logo__text {
    border: 0;
    padding: 0;
    margin: 0;
    position: absolute !important;
    height: 1px; 
    width: 1px;
    overflow: hidden;
    clip: rect(1px 1px 1px 1px);
    clip: rect(1px, 1px, 1px, 1px);
    clip-path: inset(50%);
    white-space: nowrap;
}

</style>

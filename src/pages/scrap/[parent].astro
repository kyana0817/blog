---
import type { CollectionEntry } from 'astro:content'
import Base from '../../layouts/Base.astro'
import FormattedDate from '../../components/FormattedDate.astro'
import { getScrapEntries, getScrapSections } from '../../utils/scrap'
import 'highlight.js/styles/github-dark.css'

export async function getStaticPaths() {
  return (await getScrapEntries()).map((entry) => ({
    params: { parent: entry.slug },
    props: { scrap: entry },
  }))
}

type Props = {
  scrap: CollectionEntry<'scrap'>
}

const { scrap } = Astro.props as Props
const title = scrap.data.title
const sections = await getScrapSections(scrap)
---

<Base
  title={title}
  description={scrap.data.description}
>
  <header class="c-scrap__header">
    <p class="c-scrap__label">scrap</p>
    <h1>{title}</h1>
    <p class="c-scrap__description">{scrap.data.description}</p>
    <p class="c-scrap__meta">
      <span>{sections.length}項目</span>
      <span>·</span>
      <span>
        <FormattedDate date={scrap.data.updatedDate ?? scrap.data.pubDate} />
      </span>
    </p>
  </header>
  {
    sections.length > 0 ? (
      <div class="c-scrap__content">
        {
          sections.map((section) => (
            <article class="c-scrap__section" id={section.id}>
              <h2 class="c-scrap__section-title">
                <a href={`#${section.id}`}>{section.title}</a>
              </h2>
              <div class="c-scrap__section-body">
                <Fragment set:html={section.html} />
              </div>
            </article>
          ))
        }
      </div>
    ) : (
      <p>まだメモはありません。</p>
    )
  }
</Base>
<style is:inline>
  .c-scrap__section-body > * + * {
    margin-top: 1.2rem;
  }

  .c-scrap__section-body > :first-child {
    margin-top: 0;
  }

  .c-scrap__section-body > :last-child {
    margin-bottom: 0;
  }

  .c-scrap__section-body > p > code,
  .c-scrap__section-body li > code {
    display: inline-block;
    padding: 0.15rem 0.45rem;
    margin: 0;
    border: 1px solid color-mix(in srgb, var(--border-primary) 88%, transparent);
    border-radius: 0.4rem;
    background: var(--background-primary);
    color: inherit;
    font-size: 0.9em;
    line-height: 1.2;
    word-break: break-word;
  }

  .c-scrap__section-body > pre {
    max-width: 100%;
    width: 100%;
    overflow-x: auto;
    box-sizing: border-box;
    border-radius: 0.75rem;
  }

  .c-scrap__section-body ul,
  .c-scrap__section-body ol {
    padding-left: 1.5em;
  }

  .c-scrap__section-body blockquote {
    margin: 0;
    padding-left: 1rem;
    border-left: 3px solid var(--border-secondary);
    color: var(--text-secondary, #9aa6b2);
  }
</style>
<style>
  .c-scrap__header {
    margin-bottom: 2rem;
  }

  .c-scrap__label {
    margin-bottom: 0.5rem;
    color: var(--text-hyperlink);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .c-scrap__description {
    margin: 0 0 0.75rem;
    color: var(--text-secondary, #666);
  }

  .c-scrap__meta {
    display: flex;
    gap: 0.5rem;
    color: var(--text-secondary, #666);
    margin: 0;
  }

  .c-scrap__content {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
  }

  .c-scrap__section {
    line-height: 1.7;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border-secondary);
    border-left: 4px solid var(--text-hyperlink);
    background-color: var(--background-secondary);
    min-width: 0;
  }

  .c-scrap__section-body {
    min-width: 0;
  }

  .c-scrap__section-title {
    margin: 0 0 0.75rem;
  }

  .c-scrap__section-title a {
    color: inherit;
    text-decoration: none;
  }

  .c-scrap__section-title a:hover {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .c-scrap__meta {
      flex-wrap: wrap;
    }

    .c-scrap__section {
      padding: 1rem;
    }
  }
</style>
